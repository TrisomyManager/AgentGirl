{
  "name": "xiaonuan-pc-client",
  "version": "0.2.0",
  "description": "小暖 Companion AI - PC Desktop Client (Electron + Vue 3)",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "pixi-live2d-display": {
      "gh-pages": "6.1.1"
    },
    "global-agent": "^4.1.3"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.companion.xiaonuan",
    "productName": "小暖",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "desktop-tools",
        "filter": [
          "**/*.py",
          "!tests/**",
          "!**/__pycache__/**"
        ]
      }
    ]
  },
  "scripts": {
    "dev": "set ELECTRON_RUN_AS_NODE=&& vite",
    "build": "vue-tsc --noEmit && tsc --project tsconfig.node.json --noEmit && vite build",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview",
    "test": "node tools/tests/test_builder_proxy.cjs",
    "test:watch": "node --watch tools/tests/test_builder_proxy.cjs"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "electron-store": "^8.2.0",
    "onnxruntime-web": "^1.25.1",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "vue": "^3.5.44",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.5",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^3.3.13"
  }
}
