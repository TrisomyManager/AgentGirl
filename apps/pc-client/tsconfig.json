{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["../web/src/*"],
      "vue": ["./node_modules/vue"],
      "pixi.js": ["./node_modules/pixi.js"],
      "pixi-live2d-display": ["./node_modules/pixi-live2d-display/types/index.d.ts"],
      "pixi-live2d-display/cubism2": ["./node_modules/pixi-live2d-display/types/index.d.ts"],
      "@ricky0123/vad-web": ["./node_modules/@ricky0123/vad-web"],
      "onnxruntime-web": ["./node_modules/onnxruntime-web"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../web/src/**/*.ts", "../web/src/**/*.vue"],
  "exclude": ["../web/src/**/*.test.ts"]
}
