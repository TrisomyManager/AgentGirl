; ============================================================================
; companion-ai 架构契约 (与 ARCHITECTURE.md / MODULE_CONTRACTS.md / ADR-006 对齐)
;
; 口径: 内部技术原型 + 模块化通用能力库 + 宿主无关
; 目的: 把"反向依赖 / 直连 LLM SDK / 模块横向耦合 / 共享层依赖倒置"变成 CI 红灯
;
; 波次 3 阶段: shared/ 三层拆分已完成 波次 1-2, 契约覆盖 shared_contracts / shared_runtime
; ============================================================================

[importlinter]
root_packages =
    shared_contracts
    shared_runtime
    core_orchestrator
    persona_engine
    memory_system
    voice_layer
    action_executor
    device_coordination
    gateway_adapter
    avatar_runtime
include_external_packages = True


; ----------------------------------------------------------------------------
; 契约 1: 业务模块 + 共享层 禁止反向 import core_orchestrator (ADR-006 硬约束)
; core_orchestrator 是参考集成 demo, 任何模块不应依赖它
; ----------------------------------------------------------------------------
[importlinter:contract:no-reverse-orchestrator]
name = 禁止反向 import core_orchestrator
type = forbidden
source_modules =
    shared_contracts
    shared_runtime
    persona_engine
    memory_system
    voice_layer
    action_executor
    device_coordination
    gateway_adapter
    avatar_runtime
forbidden_modules =
    core_orchestrator

[importlinter:contract:avatar-independent]
name = avatar_runtime independent of host, speech, business storage and vendors
type = forbidden
source_modules =
    avatar_runtime
forbidden_modules =
    core_orchestrator
    persona_engine
    memory_system
    voice_layer
    action_executor
    device_coordination
    gateway_adapter
    shared_runtime
    openai
    anthropic
    dashscope


; ----------------------------------------------------------------------------
; 契约 2: 业务模块 + core_orchestrator 禁止直连 LLM 厂商 SDK (ADR-006 硬约束)
; 必须通过 shared_runtime.llm_client 调用
; voice_layer/providers/ 封装层允许内部导入厂商 SDK
; ignore: core_orchestrator → voice_layer 是已知跨模块调用 (波次 3-4 解耦)
; ----------------------------------------------------------------------------
[importlinter:contract:no-direct-llm-sdk]
name = 业务模块禁止直连 LLM 厂商 SDK
type = forbidden
allow_indirect_imports = True
source_modules =
    persona_engine
    memory_system
    action_executor
    device_coordination
    gateway_adapter
    core_orchestrator
forbidden_modules =
    openai
    anthropic
    litellm
    dashscope
; ----------------------------------------------------------------------------
; 契约 3: shared_contracts 零业务依赖 + 零 shared_runtime 依赖 (核心约束)
; shared_contracts 是纯数据契约层, 只能依赖 pydantic + stdlib
; ----------------------------------------------------------------------------
[importlinter:contract:contracts-zero-dep]
name = shared_contracts 零业务依赖 + 零运行时依赖
type = forbidden
source_modules =
    shared_contracts
forbidden_modules =
    shared_runtime
    persona_engine
    memory_system
    voice_layer
    action_executor
    device_coordination
    gateway_adapter
    core_orchestrator


; ----------------------------------------------------------------------------
; 契约 4: shared_runtime 禁止 import 业务模块 (实现层不依赖业务)
; shared_runtime 是宿主可替换的运行时, 必须保持业务无关
; ----------------------------------------------------------------------------
[importlinter:contract:runtime-zero-business-dep]
name = shared_runtime 禁止 import 业务模块
type = forbidden
source_modules =
    shared_runtime
forbidden_modules =
    persona_engine
    memory_system
    voice_layer
    action_executor
    device_coordination
    gateway_adapter
    core_orchestrator


; ----------------------------------------------------------------------------
; 契约 5: 业务模块之间禁止横向 import (按"独立可拆"原则)
; 横向通信通过 shared_contracts 的事件/数据模型 或 HTTP API
; 动作实现位于 action_executor.action2d；旧 action_layer/shared 兼容包已移除
; ----------------------------------------------------------------------------
[importlinter:contract:no-cross-module-import]
name = 业务模块之间禁止横向 import
type = independence
modules =
    persona_engine
    memory_system
    voice_layer
    action_executor
    device_coordination
    gateway_adapter
