# 小暖 · 火山引擎配置：复制为本目录 .env，或通过设置页填写密钥。
# 方舟和豆包语音是不同服务，请分别开通并创建 Key。
COMPANION_LITE_MODE=true
COMPANION_MONOLITHIC=true

# 火山方舟：聊天、情绪、摘要、推理及记忆向量。
COMPANION_ARK_API_KEY=
COMPANION_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
COMPANION_DEFAULT_LLM_MODEL=doubao-seed-2-0-mini-260428
COMPANION_REASONING_LLM_MODEL=doubao-seed-2-0-pro-260215
COMPANION_WORKING_MEMORY_SUMMARY_MODEL=doubao-seed-2-0-mini-260428
COMPANION_EMBEDDING_MODEL=doubao-embedding-vision-251215
COMPANION_EMBEDDING_DIM=1024
# 向量默认共用方舟 Key，可单独覆盖：
# COMPANION_EMBEDDING_API_KEY=
# COMPANION_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 豆包语音：用于已开通的 ASR / TTS / 实时语音服务。
COMPANION_VOLC_API_KEY=
COMPANION_REALTIME_VOICE_PROVIDER=volc_realtime
COMPANION_VOLC_ENDPOINT=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
COMPANION_VOLC_RESOURCE_ID=volc.speech.dialog
COMPANION_VOLC_MODEL=1.2.1.1
COMPANION_VOLC_VOICE_ID=zh_female_xiaohe_jupiter_bigtts
# 旧版语音控制台兼容凭证（使用 API Key 无需填写）：
# COMPANION_VOLC_APP_ID=
# COMPANION_VOLC_ACCESS_TOKEN=
COMPANION_WHISPER_BASE_URL=https://openspeech.bytedance.com
COMPANION_ASR_MODEL=volc.seedasr.sauc.duration
COMPANION_TTS_PROVIDER=volcengine
COMPANION_TTS_BASE_URL=https://openspeech.bytedance.com
COMPANION_TTS_MODEL=seed-tts-2.0
COMPANION_DEFAULT_VOICE_ID=zh_female_xiaohe_uranus_bigtts
# ASR/TTS 默认使用上面的豆包语音 Key，也可单独配置：
# COMPANION_WHISPER_API_KEY=
# COMPANION_TTS_API_KEY=

COMPANION_ENABLE_VOICE=true
# SSE 分段语音：客户端还需声明 supports_segmented_voice=true。
COMPANION_ENABLE_STREAMING_TTS=true
COMPANION_STREAMING_TTS_MAX_CONCURRENCY=2
COMPANION_STREAMING_TTS_MIN_SENTENCE_CHARS=8
COMPANION_STREAMING_TTS_MAX_SENTENCE_CHARS=100
COMPANION_STREAMING_TTS_SEGMENT_TIMEOUT_SECONDS=30
COMPANION_ENABLE_DEVICE_COORDINATION=true
# 外部 2D 逐帧生成尚为占位接口；Live2D 仍使用本地动作映射。
COMPANION_ENABLE_ACTION_2D=false
COMPANION_ENABLE_KNOWLEDGE_GRAPH=false
COMPANION_JWT_SECRET=change-me-to-a-long-random-string
# COMPANION_WORKING_MEMORY_LLM_SUMMARY=true
# COMPANION_WORKING_MEMORY_LLM_DIGEST=true

# 记忆增强：本地图谱无需 Neo4j，旧对话默认按批次生成摘要。
COMPANION_ENABLE_LOCAL_MEMORY_GRAPH=true
COMPANION_WORKING_MEMORY_COMPRESSION_USE_LLM=true
COMPANION_WORKING_MEMORY_COMPRESSION_BATCH_TURNS=3
COMPANION_MEMORY_MAINTENANCE_ENABLED=true
COMPANION_MEMORY_MAINTENANCE_INTERVAL_SECONDS=3600
COMPANION_MEMORY_DREAM_USE_LLM=true
COMPANION_MEMORY_DREAM_BACKFILL_DAYS=7
COMPANION_MEMORY_TIMEZONE=Asia/Shanghai

COMPANION_ACTION_PROVIDER=local

# 独立反应分类：留空使用默认聊天模型，可指定更快的小模型。
COMPANION_REACTION_USE_LLM=true
COMPANION_REACTION_MODEL=
COMPANION_REACTION_TIMEOUT_SECONDS=3

# 意图路由：可关闭模型强制使用本地规则；超时自动回退。
COMPANION_INTENT_ROUTER_USE_LLM=true
COMPANION_INTENT_ROUTER_TIMEOUT_SECONDS=3

# 可选：宿主提供的 MCP 服务器配置文件。每个服务器必须显式列出 allowed_users。
# 配置可含命令、环境变量和认证头，仅保留在 Git 忽略的本地文件中。
# COMPANION_MCP_CONFIG_FILE=companion_mcp_config.json

# 可选本机插件：默认只发现，不执行；仅宿主私有配置可授权具体用户。
# COMPANION_PLUGINS_CONFIG_FILE=companion_plugins_config.json
# COMPANION_PLUGINS_DIR=plugins
# 内置扩展目录安装默认关闭；开启前设置已有、可写、无链接的独立目录。
# 安装只复制随应用提供的包，不更改上面的宿主执行授权。
# COMPANION_PLUGIN_INSTALL_ENABLED=false

# 默认仅本机访问。配置访问密钥后可绑定账号；对外提供服务需使用 HTTPS/WSS。
# 配置文件仅保存密钥的 SHA256。生成/轮换工具和部署边界见 docs/access-and-privacy.md。
# COMPANION_ACCESS_CONFIG_FILE=companion_access_config.json

# 多平台默认不接收、不回复；只在专用测试目标授权后启用私有绑定。
# QQ回调在单独loopback端口，主API鉴权保持不变。见docs/platform-conversations.md。
# COMPANION_PLATFORMS_CONFIG_FILE=companion_platforms_config.json
