{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaonuan.local/schemas/register-request.json",
  "title": "RegisterDeviceRequest",
  "type": "object",
  "properties": {
    "device_id": { "type": "string" },
    "user_id": { "type": "string" },
    "device_type": { "type": "string" },
    "device_name": { "type": "string" },
    "platform": { "type": "string" },
    "capabilities": { "type": "array", "items": { "type": "string" }, "default": [] },
    "ip_address": { "type": ["string", "null"] },
    "metadata": { "type": "object", "additionalProperties": true, "default": {} },
    "jwt_token": { "type": ["string", "null"] }
  },
  "required": ["device_id", "user_id", "device_type", "device_name", "platform"]
}
